{
  "name": "dsh-wechat-allsessions",
  "version": "0.2.0",
  "description": "Standalone WeChat iLink bridge that broadcasts final answers from any DSH session and routes WeChat replies back to the same session.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "third_party",
    "docs",
    "cordis.patch.yml",
    "config.example.yml",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./transport": "./lib/transport.js",
    "./router": "./lib/router.js",
    "./text": "./lib/text.js",
    "./events": "./lib/events.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test tests/*.test.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lenlanF/dsh-wechat-allsessions.git"
  },
  "homepage": "https://github.com/lenlanF/dsh-wechat-allsessions#readme",
  "bugs": {
    "url": "https://github.com/lenlanF/dsh-wechat-allsessions/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "wechat",
    "weixin",
    "ilink",
    "bridge",
    "sessions"
  ],
  "author": "lenlanF"
}
