{
  "name": "dsh-wechat-allsessions",
  "version": "0.4.8",
  "description": "微信助手：自动绑定并广播 DSH 未归档会话，支持微信端与插件内按对话管理广播和续接对话。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "bin",
    "scripts",
    "third_party",
    "docs",
    "cordis.patch.yml",
    "config.example.yml",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./transport": "./lib/transport.js",
    "./router": "./lib/router.js",
    "./text": "./lib/text.js",
    "./restart": "./lib/restart.js",
    "./events": "./lib/events.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:restart-helper": "node scripts/build-restart-helper.js",
    "test": "node --test tests/*.test.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lenlanF/dsh-wechat-allsessions.git"
  },
  "homepage": "https://github.com/lenlanF/dsh-wechat-allsessions#readme",
  "bugs": {
    "url": "https://github.com/lenlanF/dsh-wechat-allsessions/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "wechat",
    "weixin",
    "ilink",
    "bridge",
    "sessions"
  ],
  "author": "lenlanF"
}
